# ============================================================
# Universal Source Builder for free5GC + UERANSIM
# ============================================================
# Builds ALL free5GC control plane NFs, UPF, and UERANSIM
# from source inside Docker. Works on Mac, Linux, any OS.
#
# Build:
#   docker build -f Dockerfile.build-all -t free5gc-builder:v4.2.0 .
#
# Extract binaries:
#   docker run --rm -v $(pwd)/build-output:/export free5gc-builder:v4.2.0
# ============================================================

# ── Stage 1: Build all free5GC NFs from source ────────────────
FROM golang:latest AS free5gc-builder

ENV GOTOOLCHAIN=auto

RUN apt-get update && apt-get install -y --no-install-recommends \
    git gcc g++ cmake autoconf libtool pkg-config \
    libmnl-dev libyaml-dev ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/*

# Install protoc for proto code generation
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then PB_ARCH="linux-x86_64"; \
    elif [ "$ARCH" = "arm64" ]; then PB_ARCH="linux-aarch_64"; \
    else PB_ARCH="linux-x86_64"; fi && \
    wget -q "https://github.com/protocolbuffers/protobuf/releases/download/v28.3/protoc-28.3-${PB_ARCH}.zip" -O /tmp/protoc.zip && \
    unzip -q /tmp/protoc.zip -d /usr/local && rm /tmp/protoc.zip

# Install Go protoc plugin (protobuf only — no gRPC service stubs needed)
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@latest

WORKDIR /src

# Clone free5GC v4.2.0 with all submodules (NFs + go-upf)
RUN git clone --recursive -b v4.2.0 --depth 1 https://github.com/free5gc/free5gc.git \
    && cd free5gc \
    && git submodule sync \
    && git submodule update --init --recursive --depth 1

WORKDIR /src/free5gc

# Replace UDM and AMF with forked versions (from git submodules in NFs/)
RUN rm -rf NFs/udm NFs/amf
COPY NFs/udm NFs/udm
COPY NFs/amf NFs/amf

# Generate Go types from AMF proto (messages only, no gRPC service stubs)
RUN cd NFs/amf && \
    protoc \
      --go_out=internal/grpc/proto --go_opt=paths=source_relative \
      -I internal/grpc/proto \
      internal/grpc/proto/free5gc_amf.proto && \
    go mod tidy

# Build all control plane NFs (using subshells to avoid cd issues)
RUN mkdir -p /output/cp && \
    for nf in nrf amf ausf udm udr smf nssf pcf; do \
        echo "=== Building $nf ===" && \
        (cd NFs/$nf && go build -buildvcs=false -o /output/cp/$nf -trimpath ./cmd) ; \
    done

# Build go-upf (user plane function)
RUN mkdir -p /output/upf && \
    (cd NFs/upf && go build -buildvcs=false -o /output/upf/upf -trimpath ./cmd) && \
    cp -r NFs/upf/internal/forwarder/gtp5g/cmd/gogtp5g-tunnel /tmp/gogtp5g-tunnel-src || true

# Build gtp5g-tunnel utility if available
RUN if [ -d "/tmp/gogtp5g-tunnel-src" ]; then \
        cd /tmp/gogtp5g-tunnel-src && go build -o /output/upf/gogtp5g-tunnel -trimpath . ; \
    fi

# Create UPF iptables script
RUN printf '#!/bin/bash\niptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE\niptables -I FORWARD 1 -j ACCEPT\n' \
    > /output/upf/upf-iptables.sh && chmod +x /output/upf/upf-iptables.sh

# ── Stage 2: Build UERANSIM from source ───────────────────────
FROM ubuntu:22.04 AS ueransim-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git build-essential gcc g++ libsctp-dev lksctp-tools iproute2 make wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install CMake with auto-detected architecture
RUN ARCH=$(uname -m) && \
    mkdir /cmake && cd /cmake && \
    wget -q "https://github.com/Kitware/CMake/releases/download/v3.28.3/cmake-3.28.3-linux-${ARCH}.sh" -O cmake_installer.sh && \
    chmod +x cmake_installer.sh && \
    ./cmake_installer.sh --skip-license --prefix=/usr/local && \
    rm cmake_installer.sh

# Clone and build UERANSIM
RUN git clone -b master -j $(nproc) https://github.com/aligungr/UERANSIM && \
    cd UERANSIM && \
    make -j $(nproc)

# ── Stage 3: Export all binaries ──────────────────────────────
FROM ubuntu:22.04 AS export

WORKDIR /output

# Copy free5GC CP binaries
COPY --from=free5gc-builder /output/cp/ ./cp/

# Copy UPF binaries
COPY --from=free5gc-builder /output/upf/ ./upf/

# Copy UERANSIM binaries
COPY --from=ueransim-builder /UERANSIM/build/nr-gnb ./ueransim/
COPY --from=ueransim-builder /UERANSIM/build/nr-ue ./ueransim/
COPY --from=ueransim-builder /UERANSIM/build/nr-cli ./ueransim/
COPY --from=ueransim-builder /UERANSIM/build/nr-binder ./ueransim/binder/
COPY --from=ueransim-builder /UERANSIM/build/libdevbnd.so ./ueransim/binder/

# Create a manifest of what was built
RUN echo "=== free5GC Portable Build ===" > /output/BUILD_MANIFEST.txt && \
    echo "Built at: $(date -u)" >> /output/BUILD_MANIFEST.txt && \
    echo "" >> /output/BUILD_MANIFEST.txt && \
    echo "Control Plane:" >> /output/BUILD_MANIFEST.txt && \
    ls -la /output/cp/ >> /output/BUILD_MANIFEST.txt && \
    echo "" >> /output/BUILD_MANIFEST.txt && \
    echo "UPF:" >> /output/BUILD_MANIFEST.txt && \
    ls -la /output/upf/ >> /output/BUILD_MANIFEST.txt && \
    echo "" >> /output/BUILD_MANIFEST.txt && \
    echo "UERANSIM:" >> /output/BUILD_MANIFEST.txt && \
    ls -la /output/ueransim/ >> /output/BUILD_MANIFEST.txt

# Default: copy everything to /export when run with volume mount
CMD ["cp", "-r", "/output/.", "/export/"]
